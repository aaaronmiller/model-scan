{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://model-scan.local/contracts/evidence-manifest-1.0.0.json",
  "title": "Model Scan evidence publication manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_version",
    "generated_at",
    "canonicalization",
    "content_sha256",
    "content_schema_sha256",
    "validator"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "evidence_version": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "canonicalization": {"const": "model-scan-json-v1"},
    "content_sha256": {"$ref": "#/$defs/sha256"},
    "content_schema_sha256": {"$ref": "#/$defs/sha256"},
    "validator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "status", "checks"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "status": {"const": "pass"},
        "checks": {"type": "integer", "minimum": 1}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
