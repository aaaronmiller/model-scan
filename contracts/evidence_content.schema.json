{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://model-scan.local/contracts/evidence-content-1.0.0.json",
  "title": "Model Scan immutable evidence content",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_version",
    "generated_at",
    "authority",
    "source_snapshots",
    "model_identities",
    "published_observations",
    "runtime_observations",
    "calibration_results",
    "role_evaluations",
    "advisory_snapshot"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "evidence_version": {"type": "string", "minLength": 1},
    "generated_at": {"$ref": "#/$defs/utc"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["research_owner", "evidence_owner", "routing_owner", "decision_owner", "non_authority"],
      "properties": {
        "research_owner": {"const": "ardf"},
        "evidence_owner": {"const": "model-scan"},
        "routing_owner": {"const": "gateway"},
        "decision_owner": {"const": "living-documents"},
        "non_authority": {"const": true}
      }
    },
    "source_snapshots": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "model_identities": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "published_observations": {"type": "array", "items": {"type": "object"}},
    "runtime_observations": {"type": "array", "items": {"type": "object"}},
    "calibration_results": {"type": "array", "items": {"type": "object"}},
    "role_evaluations": {"type": "array", "items": {"type": "object"}},
    "advisory_snapshot": {"type": "object"}
  },
  "$defs": {
    "utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z$"
    }
  }
}
